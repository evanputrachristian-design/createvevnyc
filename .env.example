SUPABASE_PROJECT_ID=your-supabase-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional Vite client-side values (publishable key only)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only secret; never prefix with VITE_ and never expose to browser code
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Server-only rate-limit secret; use a random value of at least 32 characters
ORDER_ACCESS_RATE_LIMIT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
